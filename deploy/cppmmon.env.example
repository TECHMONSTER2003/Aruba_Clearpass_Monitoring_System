# /etc/cppmmon/cppmmon.env  (root:cppmmon 0640). install.sh generates the real
# file with random secrets on first install and never overwrites it afterwards.

# SQLAlchemy URL. MySQL 8 is the standard; SQLite is a lab-only fallback.
CPPMMON_DB_URL=mysql+pymysql://cppmmon:CHANGE_ME@127.0.0.1:3306/cppmmon?charset=utf8mb4
# CPPMMON_DB_URL=sqlite:////var/lib/cppmmon/cppmmon.db

# Flask session signing key (random, 48+ chars)
CPPMMON_WEB_SECRET=CHANGE_ME
CPPMMON_WEB_SESSION_HOURS=8
CPPMMON_WEB_COOKIE_SECURE=false

# Fernet key file for credentials at rest
CPPMMON_SECRET_KEY_FILE=/etc/cppmmon/secret.key

# Receiver ports (fallback per ADR-006: 1162/1514 + firewalld forward-port)
CPPMMON_RECEIVER_BIND=0.0.0.0
CPPMMON_RECEIVER_TRAP_PORT=162
CPPMMON_RECEIVER_SYSLOG_PORT=514

CPPMMON_DISPLAY_TZ=Asia/Kolkata
CPPMMON_LOG_LEVEL=INFO
