[Unit]
Description=CPPM Monitor - receiver (SNMP traps :162/udp, syslog :514/udp+tcp)
Documentation=file:///opt/cppmmon/docs/DESIGN.md
After=network-online.target mysql.service
Wants=network-online.target
# No Requires=mysql: the receiver must survive a DB outage (spools to disk).

[Service]
Type=simple
User=cppmmon
Group=cppmmon
EnvironmentFile=/etc/cppmmon/cppmmon.env
WorkingDirectory=/opt/cppmmon
ExecStart=/opt/cppmmon/venv/bin/python -m cppmmon.receiver.main
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cppmmon /var/log/cppmmon
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
