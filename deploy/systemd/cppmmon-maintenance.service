[Unit]
Description=CPPM Monitor - maintenance (5-min rollups, retention)
After=mysql.service

[Service]
Type=oneshot
User=cppmmon
Group=cppmmon
EnvironmentFile=/etc/cppmmon/cppmmon.env
WorkingDirectory=/opt/cppmmon
ExecStart=/opt/cppmmon/venv/bin/python -m cppmmon.jobs.maintenance
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cppmmon /var/log/cppmmon
CapabilityBoundingSet=
